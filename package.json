{
  "name": "dsh-hot-reloader",
  "version": "0.2.0",
  "description": "DSH 插件热重载器：改完插件源码即刻生效，无需重启 DeepSeek Harness。带设置页控制台、会话头部一键重载、LLM 工具，以及重载前快照体检 / 严格模式 / 限流 / 同插件互斥等安全护栏。Hot-reload DSH plugin source without restarting the harness, with a settings console, a header button, an LLM tool and pre-reload guardrails.",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hot-reload",
    "hmr",
    "live-reload",
    "development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfgil/dsh-hot-reloader.git"
  },
  "bugs": {
    "url": "https://github.com/xfgil/dsh-hot-reloader/issues"
  },
  "homepage": "https://github.com/xfgil/dsh-hot-reloader#readme",
  "author": "xfgil",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "link-peers": "node scripts/link-peers.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}